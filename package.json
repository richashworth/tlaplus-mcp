{
  "name": "@richashworth/tlaplus-mcp",
  "version": "0.2.1",
  "description": "MCP server for TLA+ toolchain (TLC, SANY, PlusCal, TLATeX)",
  "license": "MIT",
  "author": "Richard Ashworth",
  "repository": {
    "type": "git",
    "url": "https://github.com/richashworth/tlaplus-mcp.git"
  },
  "homepage": "https://github.com/richashworth/tlaplus-mcp",
  "bugs": {
    "url": "https://github.com/richashworth/tlaplus-mcp/issues"
  },
  "keywords": [
    "tla+",
    "tlaplus",
    "mcp",
    "model-checking",
    "tlc",
    "formal-verification",
    "pluscal",
    "model-context-protocol"
  ],
  "type": "module",
  "bin": {
    "tlaplus-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
